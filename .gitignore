# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Large/regenerable pulled data - keep only the committed sample files
data/raw/*.csv
!data/raw/*_sample.csv

# Generated reports (regenerated by the pipeline) -- charts are committed
# so the README can embed them directly on GitHub; tabular/text outputs stay
# regenerate-only since their content is already reproduced in the README.
reports/*.csv
reports/*.json
reports/*.md
!reports/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
